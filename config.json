{
  "origin": "CPH",
  "currency": "dkk",

  "_scan": "Which departure months to look at. 0 = this month, 9 = nine months from now. markets = which country versions of Aviasales to check (\"\" = default for CPH). Different markets can list different agencies and prices.",
  "scan": {
    "months_from": 0,
    "months_to": 9,
    "min_days_until_departure": 7,
    "max_pages_per_month": 2,
    "markets": ["", "dk", "us", "gb", "de", "se", "es"],
    "pause_seconds": 0.6
  },

  "_deal_rule": "A flight is a deal if it is at least min_discount below the median price for that destination in that month, OR under the region's price limit. 'hot' = both at once.",
  "deal_rule": {
    "min_discount": 0.30,
    "min_samples_for_median": 6,
    "median_window_days": 30,
    "max_stops_each_way": 2,
    "max_deals_per_destination": 3,
    "buy_min_discount": 0.45,
    "buy_max_share_of_limit": 0.60
  },

  "_exclude_countries": "Countries you never want to see (ISO codes). TR = Turkey.",
  "exclude_countries": ["TR"],

  "_regions": "price_limit = return price in DKK per person that always counts as a deal. min_days/max_days = trip length. europe=true puts the region in the separate Europe tab.",
  "regions": {
    "southeast_asia":   { "label": "Southeast Asia",          "price_limit": 3000, "min_days": 12, "max_days": 35 },
