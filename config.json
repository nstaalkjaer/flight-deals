    "south_asia":       { "label": "South Asia",              "price_limit": 3000, "min_days": 12, "max_days": 35 },
    "middle_east":      { "label": "Middle East",             "price_limit": 2000, "min_days": 12, "max_days": 35 },
    "caucasus_central_asia": { "label": "Caucasus & Central Asia", "price_limit": 1500, "min_days": 12, "max_days": 35 },
    "north_africa":     { "label": "North Africa",            "price_limit": 1200, "min_days": 12, "max_days": 35 },
    "africa":           { "label": "Sub-Saharan Africa",      "price_limit": 3500, "min_days": 12, "max_days": 35 },
    "indian_ocean":     { "label": "Indian Ocean islands",    "price_limit": 4500, "min_days": 12, "max_days": 35 },
    "north_america":    { "label": "USA & Canada",            "price_limit": 2700, "min_days": 12, "max_days": 35 },
    "caribbean_central":{ "label": "Mexico, Central America & Caribbean", "price_limit": 3500, "min_days": 12, "max_days": 35 },
    "south_america":    { "label": "South America",           "price_limit": 4000, "min_days": 12, "max_days": 35 },
