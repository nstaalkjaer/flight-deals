  "_alerts": "Phone alerts via the free ntfy app. min_level: 'deal' = every new deal, 'hot' = hot and up, 'buy' = only BUY BUY BUY deals.",
  "alerts": {
    "enabled": true,
    "min_level": "buy",
    "include_europe": false,
